CORS_ORIGINS=http://localhost:5173

AUTH_REQUIRED=false
AUTH_TEST_USER_ID=00000000-0000-0000-0000-000000000000
REPOSITORY_BACKEND=memory
RESEARCH_MODE=mock

SUPABASE_URL=
